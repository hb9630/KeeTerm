[Unit]
Description=term-gateway 0.2 (standalone web terminal: local/ssh targets, containers, tmux, file explorer)
After=network.target

[Service]
ExecStart=/home/huangbin/KeeTerm/target/release/term-gateway 7697 --auth-file /home/huangbin/KeeTerm/pass.txt
Restart=always
RestartSec=3
User=huangbin

[Install]
WantedBy=multi-user.target
